rules_version = '2';

// DsignX Ops — who may read and write what.
//
// Access is granted by a document at links/{uid}:
//   • the owner's link ({role: 'owner'}) is created once, during first-time setup;
//   • team members' links ({memberId}) are created by the redeemInvite function when
//     they enter a valid invite code. Their role comes from team/{memberId}.
// Deleting a link (Team → Revoke) removes access immediately.

service cloud.firestore {
  match /databases/{database}/documents {

    // The only email address allowed to become the owner. Keep in sync with
    // ownerEmail in js/firebase-config.js.
    function ownerEmail() { return 'estelle@dsignx.co.za'; }

    function signedIn() { return request.auth != null; }
    function linkPath() { return /databases/$(database)/documents/links/$(request.auth.uid); }
    function hasLink() { return signedIn() && exists(linkPath()); }
    function lnk() { return get(linkPath()).data; }
    function isOwner() { return hasLink() && lnk().get('role', '') == 'owner'; }
    function memberPath() { return /databases/$(database)/documents/team/$(lnk().get('memberId', '')); }
    function memberOk() {
      return hasLink() && lnk().get('role', '') != 'owner' && lnk().get('memberId', null) is string
        && exists(memberPath()) && get(memberPath()).data.get('active', true) != false;
    }
    function role() { return isOwner() ? 'owner' : (memberOk() ? get(memberPath()).data.get('role', 'none') : 'none'); }
    function isTeam() { return role() in ['owner', 'designer', 'technician']; }
    function isStaff() { return role() in ['owner', 'designer']; }
    // Cash-ups: the owner, plus members the owner ticked "Can do cash-ups" (team/{id}.canCashup).
    function canCashup() { return isOwner() || (memberOk() && get(memberPath()).data.get('canCashup', false) == true); }

    // First-time setup marker: who the owner is.
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == ownerEmail()
        && request.resource.data.uid == request.auth.uid
        && getAfter(linkPath()).data.get('role', '') == 'owner';
      allow update, delete: if false;
    }

    // Access links. Members' links are written by Cloud Functions (which bypass these rules).
    match /links/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'owner'
        && !exists(/databases/$(database)/documents/meta/owner)
        && existsAfter(/databases/$(database)/documents/meta/owner);
      allow delete: if isOwner() && uid != request.auth.uid;
      allow update: if false;
    }

    match /team/{id} {
      allow read: if isTeam();
      allow write: if isOwner();
    }

    match /config/{id} {
      allow read: if isTeam();
      allow write: if isStaff();  // designers advance quote/invoice numbers
    }

    match /customers/{id} {
      allow read, write: if isStaff();
    }

    match /orders/{id} {
      allow read: if isTeam();
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (role() == 'technician'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'status', 'category', 'description', 'qty', 'dueDate', 'notes',
              'designerId', 'designerName', 'technicianId', 'technicianName',
              'technician2Id', 'technician2Name',
              'updatedAt', 'invoicedAt'
            ])
            && (!('status' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.status != 'invoiced' && resource.data.status != 'invoiced')));
    }

    match /wa_handled/{id} {
      allow read, write: if isStaff();
    }

    // Product catalogue (price list used on quotes and invoices).
    match /products/{id} {
      allow read, write: if isStaff();
    }

    // Stock takes: everyone on staff can see them; only the owner starts, counts and finalises.
    match /stocktakes/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isOwner();
    }

    // Payments received (owner and designers issue receipts). Never deleted: the owner can mark one void instead.
    // People allowed to cash up may read receipts and lock them to a cash-up.
    match /receipts/{id} {
      allow read: if isStaff() || canCashup();
      allow create: if isStaff();
      allow update: if isStaff()
        || (canCashup() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cashupDate']));
      allow delete: if false;
    }

    // Daily cash-ups. Designers can see them (a cashed-up day can't take new receipts);
    // only the owner and people allowed to cash up can save one; only the owner can reopen (delete) one.
    match /cashups/{date} {
      allow read: if isStaff() || canCashup();
      allow create, update: if canCashup();
      allow delete: if isOwner();
    }

    // Everything else (including the functions' rate-limit records) is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
